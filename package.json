{
  "name": "sillytavern-desktop",
  "productName": "SillyTavern Desktop",
  "version": "1.4.1",
  "description": "Standalone desktop app for SillyTavern — built-in browser, no cmd required",
  "license": "AGPL-3.0",
  "author": "Fox",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:all": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.fox.sillytaverndesktop",
    "productName": "SillyTavern Desktop",
    "files": [
      "main.js",
      "preload.js",
      "st-preload.js",
      "userscripts.js",
      "maintenance.js",
      "setup.js",
      "themes.js",
      "shell.js",
      "winlayer.js",
      "instances.js",
      "extensions.js",
      "appupdate.js",
      "lan.js",
      "profiles.js",
      "downloader.js",
      "history.js",
      "migrate.js",
      "bar-preload.js",
      "examples/**",
      "fonts/**",
      "launcher.html",
      "stbar.html",
      "icon.ico",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/qrcode-generator/{test,experiment}/**",
      "!node_modules/qrcode-generator/dist/qrcode_SJIS.*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "SillyTavern-Desktop.exe",
      "splashImage": "splash.bmp"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "SillyTavern-Desktop-Setup.exe",
      "include": "installer.nsh"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "qrcode-generator": "2.0.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
